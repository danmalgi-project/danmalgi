# webrtc-adapter 설정 예시
# 각 값은 실행 시 동일한 이름의 flag(--grpc-addr 등)로도 넘길 수 있으며,
# flag > env > 기본값 순으로 적용된다.
# run.ps1 / run.sh는 이 파일을 읽어 프로세스 환경변수로 주입한다.

# signaling gRPC 서버 주소 (main 서버의 SERVER_PORT). 기본값: localhost:8083
GRPC_ADDR=localhost:8083

# 어댑터가 브라우저에 노출하는 HTTPS/WSS 리슨 주소. 기본값: :8888
LISTEN_ADDR=:8888

# 시그널링 대상 채널 ID(정수). 기본값: 0
CHANNEL_ID=0

# signaling 서버 인증에 쓸 고정 JWT. tools/webrtc-adapter/cmd/gen-token으로 발급한다.
# 선택값 — userId 쿼리 없이 접속하는 연결의 fallback 토큰. JWT_SECRET이 있으면 없어도 된다.
JWT_TOKEN=

# userId 기반 연결별 토큰 발급에 쓸 서명 키. 서버 루트 .env의 JWT_SECRET과 동일한 값이어야
# 서버 AuthMiddleware 검증을 통과한다. run.ps1/run.sh는 서버 .env 값을 자동 주입하므로
# 이 항목은 수동 실행(go run .)/override 용이다. JWT_TOKEN과 둘 중 하나는 있어야 한다.
JWT_SECRET=

# 어댑터 자체 HTTPS 인증서/개인키 경로. ssl.sh/ssl.ps1로 재발급한다. 기본값: server.crt / server.key
TLS_CERT=server.crt
TLS_KEY=server.key
