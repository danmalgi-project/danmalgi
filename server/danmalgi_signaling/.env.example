# danmalgi signaling 서버 환경변수 예시
#
# 사용법: 이 파일을 루트에 `.env`로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# `cmd/webrtc/main.go`가 기동 시 godotenv로 `<root>/.env`를 로드한다.
# 실제 값이 담긴 `.env`는 커밋하지 않는다(.gitignore 처리).
#
# standalone 모드(`--standalone` 또는 STANDALONE=true)에서는 이 파일이 없어도 서버가 뜬다.
# 빠진 값은 `cmd/webrtc/standalone.go`의 기본값으로 채워지고,
# Redis / 내부 API 관련 값은 인프로세스 fake로 대체되므로 아예 쓰이지 않는다.
# 이미 설정된 값은 덮어쓰지 않으므로, 이 파일이 있으면 여기 값이 항상 우선한다.

# --- 서버 ---

# gRPC 서버가 수신할 포트. 필수.
SERVER_PORT=8083

# health check(`/health`) HTTP 서버가 수신할 포트. 필수 —
# 비워두면 `:`로 바인딩되어 매 기동마다 임의 포트가 잡힌다.
HEALTH_PORT=8084

# --- TLS ---

# gRPC 서버의 TLS 사용 여부(`true`/`false`). 필수 —
# 비어 있거나 bool로 파싱할 수 없으면 기동 단계에서 실패한다.
TLS=false

# TLS 인증서/개인키 경로. `TLS=true`일 때만 사용한다.
TLS_CERT=
TLS_KEY=

# --- WebRTC ---

# ICE host candidate에 1:1 NAT 매핑으로 광고할 서버 IP.
# 클라이언트가 실제로 도달할 수 있는 주소여야 한다(로컬 개발은 사설 IP).
NAT_IP=127.0.0.1

# --- 인증 ---

# JWT 서명·검증 키. `pkg/util/token`이 호출 시점에 이 값을 읽는다.
# `tools/webrtc-adapter`도 동일한 값을 써야 서버 AuthMiddleware 검증을 통과한다.
JWT_SECRET=change-me

# --- Redis (voice presence 저장소) ---
# standalone 모드에서는 인프로세스 miniredis로 대체되어 이 값들이 무시된다.

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- 내부 API 서버 (이 서버가 gRPC 클라이언트로 호출) ---
# standalone 모드에서는 인프로세스 fake(UserStoreService)로 대체되어 이 값들이 무시된다.

API_SERVER_HOST=localhost
API_SERVER_PORT=8080

# --- standalone (로컬 검증 전용) ---

# true면 Redis·내부 API를 인프로세스 fake로 대체해 외부 의존성 없이 기동한다.
# `--standalone` 플래그와 동일하다. 운영 배포에서는 절대 켜지 않는다.
STANDALONE=false

# --- 로깅 ---

# 로그 파일이 기록될 디렉토리. 미설정 시 `<root>/logs`.
LOG_DIR=
